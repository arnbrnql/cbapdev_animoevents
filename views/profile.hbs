<main class="container py-4">
  {{#if error}}
    <div class="alert alert-danger" role="alert">{{error}}</div>
  {{/if}}
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm p-4">
        <div class="text-center mb-3">
          <img src="{{profileUser.profilePic}}" alt="{{profileUser.displayName}}" class="avatar-lg mb-2" />
          <h1 class="h4 fw-bold mb-1">{{profileUser.displayName}}</h1>
          <p class="text-muted small mb-2">{{profileUser.email}}</p>
          <span class="badge bg-success">
            {{profileUser.role}}{{#if (eq profileUser.role "Student")}} • {{profileUser.academicLevel}}{{/if}}
          </span>
        </div>

        <hr />

        <dl class="row small mb-3">
          <dt class="col-5 text-muted">Affiliation:</dt>
          <dd class="col-7 fw-semibold">{{profileUser.role}}</dd>

          <dt class="col-5 text-muted">Academic Level:</dt>
          <dd class="col-7 fw-semibold">
            {{#if (eq profileUser.academicLevel "N/A")}}Not Applicable ({{profileUser.role}}){{else}}{{profileUser.academicLevel}}{{/if}}
          </dd>

          <dt class="col-5 text-muted">College / Unit:</dt>
          <dd class="col-7 fw-semibold">{{profileUser.college}}</dd>

          <dt class="col-5 text-muted">Dept / Strand:</dt>
          <dd class="col-7 fw-semibold">
            {{#if (eq profileUser.department "N/A")}}All Departments / Unit-Wide{{else}}{{profileUser.department}}{{/if}}
          </dd>

          <dt class="col-5 text-muted">Campus:</dt>
          <dd class="col-7 fw-semibold">{{profileUser.campus}} Campus</dd>
        </dl>

        <div class="mb-4">
          <h2 class="h6 fw-bold small text-uppercase text-muted mb-1">About / Bio</h2>
          <p class="small mb-0 bg-light p-2 rounded border">
            {{#if profileUser.bio}}{{profileUser.bio}}{{else}}<em class="text-muted">No bio provided.</em>{{/if}}
          </p>
        </div>

        <div class="d-grid gap-2">
          <a href="/profile/edit" class="btn btn-dlsu btn-sm">Edit Profile & Affiliation</a>
          <button
            type="button"
            class="btn btn-outline-danger btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#deleteAccountModal"
          >Delete Account</button>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card border-0 shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 fw-bold mb-0">
            {{#if isOrganizer}}
              Campus Events Hosted by {{profileUser.displayName}}
            {{else}}
              My Registered Campus Events
            {{/if}}
          </h2>
          <span class="badge bg-success">{{eventCount}} Events</span>
        </div>

        <div class="list-group list-group-flush">
          {{#each userEvents}}
            <a
              href="/events/{{_id}}"
              class="list-group-item list-group-item-action py-3 d-flex flex-wrap justify-content-between align-items-center gap-2"
            >
              <div>
                <span class="badge {{statusBadgeClass}} me-1">{{status}}</span>
                <span class="badge bg-secondary bg-opacity-10 text-dark me-1">{{category}}</span>
                {{#if isGrandfathered}}
                  <span class="badge badge-grandfathered me-1">Registered Prior to Profile Update</span>
                {{/if}}
                <strong class="d-block mt-1">{{title}}</strong>
                <div class="small text-muted">{{date}} • {{time}} • {{venue}}</div>
              </div>
              <span class="btn btn-sm btn-outline-dlsu">{{#if ../isOrganizer}}Manage{{else}}View{{/if}}</span>
            </a>
          {{else}}
            <div class="p-3 text-center text-muted small">No events to display yet.</div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</main>

<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="delete-account-title" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/profile/delete">
        <div class="modal-header">
          <h2 class="modal-title h5 fw-bold text-danger" id="delete-account-title">Delete Your AnimoEvents Account?</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body small">
          <p class="mb-2">
            Deleting your account permanently removes your profile, saved bookmarks, discussion comments, and (if you are an organizer) any events hosted by your account.
          </p>
          <p class="mb-3">
            If you were registered for any full-capacity events, your slot will be released automatically so other eligible Lasallians can join.
          </p>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="confirm-account-delete" name="confirmDelete" value="yes" required />
            <label class="form-check-label fw-semibold text-danger" for="confirm-account-delete">
              I understand that deleting my account is permanent and cannot be undone.
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-danger">Permanently Delete Account</button>
        </div>
      </form>
    </div>
  </div>
</div>
