<main class="container py-5">
  <div class="row justify-content-center g-4">
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm p-4">
        <div class="text-center mb-4">
          <span
            class="badge bg-success bg-opacity-10 text-success fw-semibold mb-2"
          >De La Salle University Portal</span>
          <h1 class="h4 fw-bold mb-1">Sign In to AnimoEvents</h1>
          <p class="text-muted small mb-0">
            Use your
            <code>@dlsu.edu.ph</code>
            account to continue.
          </p>
        </div>

        {{#if error}}
          <div class="alert alert-danger small" role="alert">{{error}}</div>
        {{/if}}

        <form method="POST" action="/login">
          <div class="mb-3">
            <label for="login-email" class="form-label small fw-semibold">DLSU
              Email Address
              <span class="text-danger">*</span></label>
            <input
              type="email"
              id="login-email"
              name="email"
              class="form-control"
              required
              autocomplete="username"
              placeholder="name@dlsu.edu.ph"
              value="{{formEmail}}"
            />
          </div>
          <div class="mb-3">
            <label
              for="login-password"
              class="form-label small fw-semibold"
            >Password <span class="text-danger">*</span></label>
            <input
              type="password"
              id="login-password"
              name="password"
              class="form-control"
              required
              autocomplete="current-password"
              minlength="8"
              placeholder="Enter your password"
            />
          </div>
          <button type="submit" class="btn btn-dlsu w-100 mb-3">Sign In</button>
          <div class="text-center small">
            New to AnimoEvents?
            <a
              href="/register"
              class="text-success fw-semibold text-decoration-none"
            >Create a DLSU Account</a>
          </div>
        </form>
      </div>
    </div>

    {{#if demoMode}}
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm p-4">
        <h2 class="h6 fw-bold mb-2">Try a sample account</h2>
        <p class="small text-muted mb-3">
          Choose an account below to fill the login form and preview the
          experience for a different role or campus affiliation. The demo
          password is
          <code>AnimoPass123!</code>.
        </p>

        <div class="list-group small">
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            data-fill-email="miguel_tan@dlsu.edu.ph"
          >
            <div>
              <strong>Miguel Lorenzo Tan</strong>
              <span class="badge bg-success ms-1">Student • Undergraduate</span>
              <div class="text-muted">CCS / ST • Manila Campus</div>
            </div>
            <span class="btn btn-sm btn-outline-dlsu">Select</span>
          </button>
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            data-fill-email="sophia_sy@dlsu.edu.ph"
          >
            <div>
              <strong>Sophia Gabrielle Sy</strong>
              <span class="badge bg-success ms-1">Student • Senior High School</span>
              <div class="text-muted">SHS / STEM • Manila Campus</div>
            </div>
            <span class="btn btn-sm btn-outline-dlsu">Select</span>
          </button>
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            data-fill-email="hannah_reyes@dlsu.edu.ph"
          >
            <div>
              <strong>Hannah Sofia Reyes</strong>
              <span class="badge bg-success ms-1">Student • Graduate</span>
              <div class="text-muted">CCS / IT • Manila Campus (Sees Graduate
                Research Clinic)</div>
            </div>
            <span class="btn btn-sm btn-outline-dlsu">Select</span>
          </button>
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            data-fill-email="rafael.cruz@dlsu.edu.ph"
          >
            <div>
              <strong>Dr. Rafael Antonio Cruz</strong>
              <span class="badge bg-primary ms-1">Faculty</span>
              <div class="text-muted">CCS / ST • Manila Campus</div>
            </div>
            <span class="btn btn-sm btn-outline-dlsu">Select</span>
          </button>
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            data-fill-email="carlos_mendoza@dlsu.edu.ph"
          >
            <div>
              <strong>Carlos Joaquin Mendoza</strong>
              <span class="badge bg-success ms-1">Student • Graduate</span>
              <div class="text-muted">GCOE / ECE • Laguna Campus</div>
            </div>
            <span class="btn btn-sm btn-outline-dlsu">Select</span>
          </button>
          <button
            type="button"
            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            data-fill-email="lscs@dlsu.edu.ph"
          >
            <div>
              <strong>La Salle Computer Society (LSCS)</strong>
              <span class="badge bg-dark ms-1">Organizer</span>
              <div class="text-muted">CCS • Manila Campus (Authorized to Publish
                & Manage Events)</div>
            </div>
            <span class="btn btn-sm btn-outline-dlsu">Select</span>
