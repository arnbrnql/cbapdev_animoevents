        </div>
      </div>
    </div>
    {{/if}}
  </div>
</main>

{{#if demoMode}}
  <script>
    const emailInput = document.getElementById("login-email");
    const passwordInput = document.getElementById("login-password");
    document.querySelectorAll("[data-fill-email]").forEach(function (button) {
      button.addEventListener("click", function () {
        emailInput.value = button.dataset.fillEmail;
        passwordInput.value = "AnimoPass123!";
        document.querySelector('form[action="/login"] button[type="submit"]').focus();
      });
    });
  </script>
{{/if}}
