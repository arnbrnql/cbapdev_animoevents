<main class="container py-4">
  <div
    class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"
  >
    <div>
      <h1 class="h3 fw-bold mb-1">My Saved Event Bookmarks</h1>
      <p class="text-muted small mb-0">
        Keep track of campus events you are interested in and attach optional
        personal reminders.
      </p>
    </div>
    <span class="badge bg-success">{{bookmarkCount}} Saved Bookmarks</span>
  </div>

  {{#if currentUser}}
    {{#if eligibleEvents}}
    <section class="card border-0 shadow-sm p-3 mb-4">
      <h2 class="h6 fw-bold mb-2">Quick-Add Event to Bookmarks</h2>
      <form method="POST" action="/bookmarks" class="row g-2 align-items-end">
        <div class="col-md-5">
          <label
            for="bm-event-select"
            class="form-label small fw-semibold mb-1"
          >Select Eligible Event <span class="text-danger">*</span></label>
          <select
            id="bm-event-select"
            name="eventId"
            class="form-select form-select-sm"
            required
          >
            {{#each eligibleEvents}}
              <option value="{{_id}}">
                {{title}}
                ({{date}}
                •
                {{status}})
              </option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-5">
          <label
            for="bm-personal-note"
            class="form-label small fw-semibold mb-1"
          >
            Personal Note / Reminder
            <span class="text-muted fw-normal">(Optional, max 250 chars)</span>
          </label>
          <input
            type="text"
            id="bm-personal-note"
            name="personalNote"
            class="form-control form-control-sm"
            maxlength="250"
            placeholder="Leave blank or add a reminder (e.g., Bring ID and laptop)..."
          />
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-dlsu w-100">Save Bookmark</button>
        </div>
      </form>
    </section>
    {{/if}}

    <div class="d-flex flex-column gap-3">
      {{#each bookmarks}}
        <article class="card card-event shadow-sm p-3">
          {{#if event}}
            <div
              class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2"
            >
              <div>
                <span
                  class="badge {{event.statusBadgeClass}} me-1"
                >{{event.status}}</span>
                <span
                  class="badge bg-secondary bg-opacity-10 text-dark me-1"
                >{{event.category}}</span>
                {{#if eligibilityChanged}}
                  <span class="badge badge-grandfathered">Eligibility Changed
                    After Profile Update</span>
                {{/if}}
              </div>
              <small class="text-muted">Saved {{createdAt}}</small>
            </div>

            <h3 class="h5 fw-bold mb-1">
              <a
                href="/events/{{event._id}}"
                class="text-decoration-none text-dark"
              >{{event.title}}</a>
            </h3>
            <p class="small text-muted mb-2">
              Hosted by
              {{event.organizerName}}
              •
              {{event.date}}
              •
              {{event.time}}
              •
              {{event.venue}}
            </p>
          {{else}}
            <h3 class="h5 fw-bold mb-1">Event unavailable</h3>
            <p class="small text-muted mb-2">You can still edit your personal note or remove the bookmark.</p>
          {{/if}}

          <div class="small bg-light p-2 rounded border mb-3">
            {{#if personalNote}}
              <strong>Personal Note:</strong>
              {{personalNote}}
            {{else}}
              <em class="text-muted">No personal note added.</em>
            {{/if}}
          </div>

          <div class="row g-2 align-items-center">
            <div class="col-md-9">
              <form
                method="POST"
                action="/bookmarks/{{_id}}/edit"
                class="d-flex gap-2"
              >
                <input
                  type="text"
                  name="personalNote"
                  aria-label="Personal note"
                  class="form-control form-control-sm"
                  maxlength="250"
                  value="{{personalNote}}"
                  placeholder="Optional personal note (leave blank to clear)..."
                />
                <button
                  type="submit"
                  class="btn btn-sm btn-outline-dlsu text-nowrap"
                >Save Note</button>
              </form>
            </div>
            <div class="col-md-3 text-md-end">
              <form
                method="POST"
                action="/bookmarks/{{_id}}/delete"
                class="d-inline"
              >
                <button
                  type="submit"
                  class="btn btn-sm btn-outline-danger"
                >Remove</button>
              </form>
            </div>
          </div>
        </article>
      {{else}}
        <div class="card border-0 shadow-sm p-4 text-center text-muted">
          You have no saved bookmarks yet. Browse events to find something to save.
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="card border-0 shadow-sm p-4 text-center">
      Please
      <a href="/login" class="text-success fw-semibold">sign in</a>
      to view and manage your saved bookmarks.
    </div>
  {{/if}}
</main>