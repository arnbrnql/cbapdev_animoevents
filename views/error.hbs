<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card border-0 shadow-sm p-4 text-center">
        <div class="mb-2">
          <span class="badge badge-tag-restricted px-3 py-2">Notice</span>
        </div>
        <h1 class="h4 fw-bold mb-2">{{#if title}}{{title}}{{else}}Request Error{{/if}}</h1>
        <p class="text-muted small mb-4">
          {{#if message}}{{message}}{{else}}The requested page or resource could
            not be accessed.{{/if}}
        </p>
        <div class="d-flex justify-content-center gap-2">
          <a href="/" class="btn btn-dlsu btn-sm">Return to Home Feed</a>
          <a href="/events" class="btn btn-outline-secondary btn-sm">Browse
            Events</a>
        </div>
      </div>
    </div>
  </div>
</main>