<main class="container py-4">
  <div class="mb-3">
    <a href="/events" class="text-decoration-none text-success small fw-semibold">← Back to Campus Events Directory</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <article class="card border-0 shadow-sm p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <span class="badge {{event.statusBadgeClass}} me-1">{{event.status}}</span>
            <span class="badge bg-secondary bg-opacity-10 text-dark me-1">{{event.category}}</span>
            <span class="{{#if event.isPublic}}badge-tag{{else}}badge-tag-restricted{{/if}}">{{event.audienceLabel}}</span>
          </div>
          {{#if currentUser}}
            {{#if event.isOwner}}
              <div>
                <a href="/events/{{event._id}}/edit" class="btn btn-sm btn-dlsu">Edit / Manage Event</a>
              </div>
            {{/if}}
        </div>

        {{#if event.isGrandfathered}}
            <div class="alert alert-warning small">
              <strong>Registered prior to profile update:</strong> Your current profile no longer matches this event's target audience criteria. Your existing registration slot remains valid, but if you leave this event you will not be able to re-register.
            </div>
        {{/if}}

        <h1 class="h3 fw-bold mb-2">{{event.title}}</h1>
        <p class="text-muted small mb-3">
            Hosted by <a href="/organizers/{{event.organizer}}" class="text-success fw-semibold text-decoration-none">{{event.organizerName}}</a>
            • Date: <strong>{{event.date}}</strong>
            • Time: <strong>{{event.time}}{{#if event.endTime}}–{{event.endTime}}{{/if}}</strong>
            • Venue: <strong>{{event.venue}}</strong>
        </p>
        <p class="mb-4">{{event.description}}</p>

        <div class="d-flex flex-wrap gap-2 pt-3 border-top">
            {{#if event.isOwner}}
              <a href="/events/{{event._id}}/edit" class="btn btn-dlsu">Manage Event Details & Status</a>
            {{else if event.isOrganizerViewer}}
              <span class="btn btn-light border disabled text-muted">Organizers host events</span>
            {{else if event.isArchived}}
              <button type="button" class="btn btn-secondary" disabled>
                {{#if event.isJoined}}Registered ({{event.status}}){{else}}Event {{event.status}}{{/if}}
              </button>
            {{else if event.isJoined}}
              <form method="POST" action="/events/{{event._id}}/leave" class="d-inline">
                <input type="hidden" name="returnTo" value="/events/{{event._id}}" />
                <button type="submit" class="btn btn-outline-danger">Leave Event (Registered)</button>
              </form>
            {{else if event.isOpen}}
              <form method="POST" action="/events/{{event._id}}/join" class="d-inline">
                <input type="hidden" name="returnTo" value="/events/{{event._id}}" />
                <button type="submit" class="btn btn-dlsu">Join Event (RSVP)</button>
              </form>
            {{else}}
              <button type="button" class="btn btn-secondary" disabled>Registration {{event.status}}</button>
            {{/if}}

            <form method="POST" action="/bookmarks{{#if event.isBookmarked}}/remove-event{{/if}}" class="d-inline">
              <input type="hidden" name="eventId" value="{{event._id}}" />
              <input type="hidden" name="returnTo" value="/events/{{event._id}}" />
              <button type="submit" class="btn btn-outline-dlsu {{#if event.isBookmarked}}active{{/if}}">
                {{#if event.isBookmarked}}Remove Bookmark{{else}}Bookmark Event{{/if}}
              </button>
            </form>
          {{else}}
            <a href="/login" class="btn btn-sm btn-outline-dlsu">Sign in to {{#if event.isOpen}}join or {{/if}}bookmark</a>
          {{/if}}
        </div>
      </article>

      <section class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h5 fw-bold mb-0">Event Updates & Discussion Thread</h2>
          <span class="badge bg-secondary">{{event.updateCount}} Posts</span>
        </div>

        {{#if discussionError}}
          <div class="alert alert-danger small" role="alert">{{discussionError}}</div>
        {{/if}}
        {{#if currentUser}}
          <form method="POST" action="/events/{{event._id}}/updates" class="mb-4">
            <label for="thread-content" class="form-label small fw-semibold">
              {{#if event.isOwner}}Publish an Official Host Update{{else}}Post a Question or Comment{{/if}}
            </label>
            <textarea
              id="thread-content"
              name="content"
              class="form-control form-control-sm mb-2"
              rows="3"
              required
              minlength="2"
              maxlength="500"
              placeholder="Share a question, resource note, or official announcement (2–500 characters)..."
            >{{discussionContent}}</textarea>
            <div class="d-flex justify-content-between align-items-center">
              <span class="small text-muted">
                {{#if event.isOwner}}
                  Posting as <strong>Event Organizer</strong> — your post will appear in the updates feed for registered participants.
                {{else}}
                  Posting as <strong>{{currentUser.displayName}} ({{currentUser.role}})</strong>
                {{/if}}
              </span>
              <button type="submit" class="btn btn-sm btn-dlsu">Publish Post</button>
            </div>
          </form>
        {{else}}
          <div class="alert alert-light border small mb-4">
            Please <a href="/login" class="text-success fw-semibold">sign in</a> to post questions or comments in this discussion thread.
          </div>
        {{/if}}

        <div class="d-flex flex-column gap-3" id="thread-posts-list">
          {{#each updates}}
            <div class="p-3 rounded border {{#if isOfficialUpdate}}thread-official{{else}}bg-white{{/if}}">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1">
                <div>
                  <span class="fw-bold small">{{authorName}}</span>
                  {{#if isOfficialUpdate}}
                    <span class="badge bg-success ms-1">Official Host Update</span>
                  {{else}}
                    <span class="badge bg-light text-dark border ms-1">{{authorRole}}</span>
                  {{/if}}
                </div>
                <div class="d-flex align-items-center gap-2">
                  <small class="text-muted">{{postedAt}}</small>
                  {{#if canEdit}}
                    <button
                      type="button"
                      class="btn btn-link btn-sm p-0 text-success text-decoration-none"
                      data-edit-upd="{{_id}}"
                    >Edit</button>
                  {{/if}}
                  {{#if canDelete}}
                    <form method="POST" action="/events/{{../event._id}}/updates/{{_id}}/delete" class="d-inline">
                      <button type="submit" class="btn btn-link btn-sm p-0 text-danger text-decoration-none">Delete</button>
                    </form>
                  {{/if}}
                </div>
              </div>

              <p class="small mb-0" id="upd-text-{{_id}}">{{content}}</p>

              {{#if canEdit}}
                <form
                  method="POST"
                  action="/events/{{../event._id}}/updates/{{_id}}/edit"
                  class="mt-2 {{#unless editing}}d-none{{/unless}}"
                  id="upd-edit-form-{{_id}}"
                >
                  <textarea
                    name="content"
                    aria-label="Edit discussion post"
                    class="form-control form-control-sm mb-2"
                    rows="2"
                    required
                    minlength="2"
                    maxlength="500"
                  >{{draftContent}}</textarea>
                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-dlsu">Save Changes</button>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-secondary"
                      data-cancel-upd="{{_id}}"
                    >Cancel</button>
                  </div>
                </form>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </section>
    </div>

    <aside class="col-lg-4">
      <div class="card border-0 shadow-sm p-3 mb-4">
        <h2 class="h6 fw-bold mb-2">Registration Capacity</h2>
        <div class="d-flex justify-content-between small mb-1">
          <span>{{event.attendeeCount}} of {{event.maxCapacity}} slots filled</span>
          <span class="fw-semibold">{{capacityPercent}}%</span>
        </div>
        <div class="progress mb-3" style="height: 10px">
          <div class="progress-bar bg-success" role="progressbar" style="width: {{capacityPercent}}%"></div>
        </div>
        <p class="small text-muted mb-0">
          Students and Faculty who register automatically receive official host updates on their Home Feed and Calendar.
        </p>
      </div>

      <div class="card border-0 shadow-sm p-3">
        <h2 class="h6 fw-bold mb-3">Confirmed Participants ({{event.attendeeCount}})</h2>
        <ul class="list-group list-group-flush">
          {{#each confirmedParticipants}}
            <li class="list-group-item px-0 d-flex align-items-center gap-2">
              <img src="{{profilePic}}" alt="{{displayName}}" class="avatar-sm" />
              <div>
                <div class="small fw-semibold">{{displayName}}</div>
                <div class="text-muted" style="font-size: 0.75rem">
                  {{role}}{{#if (eq role "Student")}} ({{academicLevel}}){{/if}} • {{college}}/{{department}} ({{campus}})
                </div>
              </div>
            </li>
          {{else}}
            <li class="list-group-item px-0 small text-muted">No participants registered yet.</li>
          {{/each}}
        </ul>
      </div>
    </aside>
  </div>
</main>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("[data-edit-upd]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const id = btn.getAttribute("data-edit-upd");
        const textEl = document.getElementById("upd-text-" + id);
        const formEl = document.getElementById("upd-edit-form-" + id);
        if (textEl) textEl.classList.add("d-none");
        if (formEl) formEl.classList.remove("d-none");
      });
    });
    document.querySelectorAll("[data-cancel-upd]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const id = btn.getAttribute("data-cancel-upd");
        const textEl = document.getElementById("upd-text-" + id);
        const formEl = document.getElementById("upd-edit-form-" + id);
        if (textEl) textEl.classList.remove("d-none");
        if (formEl) formEl.classList.add("d-none");
      });
    });
  });
</script>